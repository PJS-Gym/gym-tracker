# Copy to .env.local. Keys: Clerk dashboard → Configure → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# FastAPI backend, without a trailing slash (server-side calls only).
API_URL=http://localhost:8000

# `bun dev` only: run without Clerk to click through the UI. Leave the keys above empty.
# NEXT_PUBLIC_UI_PREVIEW=1
